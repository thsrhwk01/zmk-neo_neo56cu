/dts-v1/;

#include <st/f0/stm32f072Xb.dtsi>
#include <st/f0/stm32f072c(8-b)tx-pinctrl.dtsi>

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    model = "Neo65 CU Wired";
    compatible = "neo,neo65cu", "st,stm32f072";

    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,code-partition = &code_partition;
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    aliases {
        caps-led = &caps_lock_led;
    };

    leds {
        compatible = "gpio-leds";

        caps_lock_led: caps_lock_led {
            gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
            label = "Caps Lock";
        };
    };

    /*
     * Keep every switch position exposed by QMK's LAYOUT_wired. Alternate
     * split-backspace, ISO, split-left-shift, and bottom-row footprints can
     * therefore use the same firmware; unpopulated footprints are harmless.
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <16>;
        rows = <5>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7)
            RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15)

            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7)
            RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,15)

            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7)
            RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,15)

            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7)
            RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13) RC(4,15)

            RC(4,0) RC(4,1) RC(4,2) RC(4,6) RC(4,10) RC(4,11)
            RC(4,12) RC(4,13) RC(4,14)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";

        /* QMK COL2ROW scans by driving rows low and reading pulled-up cols. */
        diode-direction = "row2col";
        debounce-press-ms = <5>;
        debounce-release-ms = <5>;

        col-gpios
            = <&gpioc 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpioc 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpioa 0  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpioa 1  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpioa 2  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpioa 3  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpioa 4  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpiob 2  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpiob 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpiob 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpiob 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpiob 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpiob 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpiob 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpioa 8  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpioa 9  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;

        row-gpios
            = <&gpioa 6 GPIO_ACTIVE_LOW>
            , <&gpioa 7 GPIO_ACTIVE_LOW>
            , <&gpiob 0 GPIO_ACTIVE_LOW>
            , <&gpiob 1 GPIO_ACTIVE_LOW>
            , <&gpiob 9 GPIO_ACTIVE_LOW>
            ;
    };

    behaviors {
        neo_dfu: neo_dfu {
            compatible = "zmk,behavior-neo65cu-rom-dfu";
            #binding-cells = <0>;
            display-name = "Neo65 CU ROM DFU";
        };
    };
};
/* The vendor QMK firmware also uses internal HSI/PLL rather than HSE/LSE. */
&clk_hsi {
    status = "okay";
};

&pll {
    prediv = <1>;
    mul = <6>;
    clocks = <&clk_hsi>;
    status = "okay";
};

&rcc {
    clocks = <&pll>;
    clock-frequency = <DT_FREQ_M(48)>;
    ahb-prescaler = <1>;
    apb1-prescaler = <1>;
};

zephyr_udc0: &usb {
    pinctrl-0 = <&usb_dm_pa11 &usb_dp_pa12>;
    pinctrl-names = "default";
    num-bidir-endpoints = <4>;
    status = "okay";
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        /*
         * STM32 main flash only: 0x08000000..0x0801ffff.
         * The immutable ROM DFU at 0x1fffc800 is outside this controller and
         * cannot be linked into or written by this application partition.
         */
        code_partition: partition@0 {
            label = "code";
            reg = <0x00000000 0x00020000>;
        };
    };
};
